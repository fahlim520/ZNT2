{
  "name": "qing-task",
  "version": "0.3.0",
  "description": "A classic QQ-style top edge task manager for Windows.",
  "main": "dist-electron/main.js",
  "author": "Local",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "vite build && npm run build:electron",
    "test": "npm run build:electron && node --test tests/*.test.js",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@vitejs/plugin-react": "^4.3.4",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "word-extractor": "^1.0.4",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.local.qqslidetask",
    "productName": "轻任务",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "icon": "assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "electron/resources",
        "to": "import-resources",
        "filter": [
          "*.ps1"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**/*",
      "node_modules/@napi-rs/**/*"
    ]
  }
}
